# ── Google account (the account whose saved flights are tracked) ─────────────
GOOGLE_EMAIL=
GOOGLE_PASSWORD=
# Base32 seed from Google 2FA setup (the string behind the QR code)
TOTP_SECRET=

# ── Telegram ──────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
# Authorized users: "chat_id:Name" pairs, comma-separated.
# Every user gets price alerts; commands are answered privately per user.
#   TELEGRAM_USERS=123456789:Dmitry,987654321:Alex
TELEGRAM_USERS=
# Legacy v1 variable (plain comma-separated chat IDs). Still honored as a
# fallback — keep it set through your first v2 deploy so the old code keeps
# alerting during the build window, then it can be removed.
TELEGRAM_CHAT_ID=

# ── AWS ───────────────────────────────────────────────────────────────────────
AWS_REGION=us-east-1
PROJECT_NAME=gfpricetracker
# Minutes between tracker runs (15 keeps Lambda inside the always-free tier)
SCHEDULE_MINUTES=15

# Launch Chrome only every Nth run (refire cached requests between; 1 = every run)
BROWSER_EVERY_N=2
